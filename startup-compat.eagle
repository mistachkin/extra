###############################################################################

#
# NOTE: It is (highly) likely that this script file will be evaluated twice
#       during shell startup.  Once during interpreter creation -AND- again
#       when entering the interactive loop; therefore, this script must be
#       able to support both scenarios.
#
apply [list [list] {; # shims & startup
  if {[string length [info commands checkIsWindows]] > 0} then {
    checkIsWindows;       # [isWindows]

    checkEagleBeta28;     # [interp readylimit]
    checkEagleBeta41;     # [isNonNullObjectHandle]
    checkEagleBeta42;     # [isDotNetCore] / [doesCompileCSharpWork]
    checkEagleBeta46;     # [getShellExecutableName]
    checkEagleBeta47;     # [vwaitLocked]
    checkEagleBeta49;     # [checkForUnicodeCategory]
    checkEagleBeta51;     # SetOrUnsetTimeout Network
    checkEagleBeta53;     # [checkForOfflineMode] / [reportTestResultCounts]
    checkEagleBeta55;     # PromptFlags with +Count
    checkEagleBeta56;     # [checkForTip237] / [eagle_setupPromptScript]

    if {[string length [info commands checkAuthDevHarpy]] > 0} then {
      checkAuthDevHarpy;  # Kapok test suite license authorization
    }

    if {[info exists ::tcl_interactive] && $::tcl_interactive} then {
      checkEagleBeta36;   # interactive command history?

      #
      # HACK: This seems to increase thread contention and possibly
      #       garbage collection.
      #
      if {0} then {
        if {![info exists ::no(NoStringBuilderCache)] && \
            ![info exists ::env(NoStringBuilderCache)]} then {
          checkStringBuilderCache; # enable cache, if available
        }
      }

      #
      # HACK: Should be quiet for things like the Demo test suite.
      #       Since the "$::argv" script variable can be modified
      #       by the shell command line processing, use the (new)
      #       [info argv] sub-command to fetch the full, original
      #       command line argument list.
      #
      if {[catch {info argv} fullArgv] || \
          [llength $fullArgv] == 0} then {
        catch {eagle_showHistoryHelp}
        host result Ok "Interactive startup complete.\n"
      }
    }
  }
}]
