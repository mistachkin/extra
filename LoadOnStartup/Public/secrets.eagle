#
# NOTE: Use our own namespace here because even though we do not directly
#       support namespaces ourselves, we do not want to pollute the global
#       namespace if this script actually ends up being evaluated in Tcl.
#
namespace eval ::Secrets {
  #
  # NOTE: This procedure will prompt the interactive user for a file name
  #       pattern to match against file names within the secret repository
  #       checkout directory.  Non-zero will be returned upon success.
  #
  proc promptForAndCopySecret { {envVarName KEYS_DIR} {milliseconds 30000} } {
    # <help>
    # This procedure is the top-level entry point of the secrets package.
    # It prompts the interactive user for a file-name pattern, searches a
    # secret repository checkout for a matching file, extracts a secret
    # from that file, and copies the secret to the operating system
    # clipboard.  After a configurable delay it then scrubs the clipboard
    # so the secret does not linger in shared OS state.
    #
    # SECURITY: This procedure is the single intended interactive surface
    # for materializing a secret.  The repository checkout directory is
    # located via a caller-named environment variable so that the path is
    # never hard-coded into the script; the secret itself is held only
    # transiently in the clipboard, and the after-scheduled scrub is the
    # primary lifetime control.  All locals that touched secret-adjacent
    # data are explicitly unset in the finally clause using the
    # zero-string scrubbing form so that the procedure leaves no
    # interpreter-side residue of the search inputs.  Note that the
    # secret value itself is consumed inside the search command and not
    # returned to this frame; the only state surfaced from this
    # procedure is a boolean success flag.
    #
    # How it works: the procedure first verifies that the environment
    # variable named by "envVarName" exists, raising an error if not.
    # Its value is normalized into "path" and handed to
    # [getSecretSearchCommand] to produce an applyable command.  A
    # placeholder "null" argument is appended because [apply] always
    # expects one argument, and the command is then evaluated on the
    # current thread (blocking).  If "milliseconds" is non-negative,
    # three [after] tasks are scheduled at that delay -- one to call
    # [removeSecretFromClipboard], and two to set sentinel global
    # variables ("secretForever" and "setecAstronomy") that release the
    # subsequent [vwait] so the procedure blocks until the delay has
    # elapsed.  A negative "milliseconds" disables the wait/clear cycle
    # entirely, leaving the secret on the clipboard for the user to
    # manage.
    #
    # Tricky details: the "setecAstronomy" sentinel is a tongue-in-cheek
    # reference and is not [vwait]ed on directly here, but it is
    # available to external code that wants to observe the same expiry
    # event.  The finally clause scrubs the local copies of "envVarName",
    # "milliseconds", "command", and "result" so that they cannot be
    # mined from the call frame after return.  The procedure does NOT
    # cancel the scheduled [after] tasks on early error, so if the
    # search command throws, the scheduled clipboard scrub will still
    # run at the deadline.
    #
    # Arguments:
    #   envVarName   -- Optional.  Name of the environment variable that
    #                   contains the path to the secret repository
    #                   checkout directory.  Defaults to "KEYS_DIR".
    #   milliseconds -- Optional.  Delay before scrubbing the clipboard
    #                   and releasing the wait.  When negative, the
    #                   clipboard is NOT auto-scrubbed and the procedure
    #                   returns as soon as the search command completes.
    #                   Defaults to thirty thousand (thirty seconds).
    #
    # Results:
    #   Whatever the underlying search command returns -- typically a
    #   boolean indicating whether a matching secret was found and
    #   copied.  Raises an error when the named environment variable is
    #   not set.
    # </help>

    try {
      if {![info exists ::env($envVarName)]} then {
        error [appendArgs \
            "missing environment variable " $envVarName]
      }

      set path [file normalize $::env($envVarName)]

      set command [getSecretSearchCommand $path]; # get script.
      lappend command null; # [apply] needs one argument.
      set result [eval $command]; # block on this thread.

      if {$milliseconds >= 0} then {
        after $milliseconds \
            [namespace code removeSecretFromClipboard]

        after $milliseconds [list set ::secretForever 1]
        after $milliseconds [list set ::setecAstronomy 1]

        vwait ::secretForever
      }

      return $result
    } finally {
      unset -nocomplain -zerostring -purge -- envVarName \
          milliseconds command result
    }
  }

  #
  # NOTE: This procedure returns a (script) command that will prompt the
  #       interactive user for a file name pattern to match against file
  #       names within the secret repository checkout directory.  Non-zero
  #       will be returned upon success.
  #
  proc getSecretSearchCommand {
          path {withNull false} {filePattern ""} {patterns ""} } {
    # <help>
    # This procedure assembles -- but does not invoke -- the script
    # command that prompts the user for a secret file-name pattern,
    # enumerates the secret files within the checkout directory, and
    # invokes [findAndCopySecret] to copy a matching secret to the
    # clipboard.  It exists so that the caller can build the command
    # once (capturing the search inputs at construction time) and then
    # evaluate it on a thread or context of its choosing.
    #
    # SECURITY: The returned command is plain text and contains literal
    # copies of the path, file pattern, and custom regex patterns the
    # caller provided.  Those values are baked in via [string map] over
    # placeholder tokens (%path%, %filePattern%, %patterns%) and therefore
    # become part of the script source -- callers should treat the
    # returned command as sensitive in the same way they would treat the
    # inputs themselves.  When the command is later evaluated, it
    # establishes a HotKey.Enterprise no-complaint flag and the
    # AllowAnyThread environment variable (both flagged EXEMPT in the
    # body) so that the prompt-and-clipboard plumbing is permitted to
    # cross thread boundaries.  Inside the apply body, a try/finally
    # block scrubs the local copies of the search inputs and the loaded
    # assembly reference with the zero-string scrubbing form of unset
    # so they do not linger after the apply returns.
    #
    # How it works: a single-element list containing an [apply] of a
    # one-argument anonymous procedure is constructed.  The body of the
    # apply is a triple-quoted template whose %path%, %filePattern%, and
    # %patterns% placeholders are substituted with the caller's values
    # via [string map] BEFORE the apply object is finalized.  Inside the
    # apply, the HotKey enterprise plugin is required and the
    # Microsoft.VisualBasic assembly is loaded so that
    # Interaction.InputBox can be invoked to prompt for a pattern when
    # the caller did not provide one.  When a pattern is in hand, a
    # cached list of candidate files is reused from
    # eagle_debugger(secrets) if present, or freshly enumerated via
    # [findFilesRecursive] under "path/*.txt" and cached for future
    # calls.  The cached list is then passed to [findAndCopySecret].  If
    # the prompt is dismissed without input, false is returned.  The
    # outer procedure's [namespace current] is captured as the apply's
    # namespace so the apply body has access to the package's other
    # procedures by name.  When "withNull" is true, a literal "null"
    # element is appended to the returned command so the caller can
    # invoke the command directly without an extra placeholder argument.
    #
    # Tricky details: the apply body deliberately re-declares "path",
    # "filePattern", and "patterns" as local variables seeded from the
    # placeholder substitutions, so that the body remains compilable on
    # its own and the values appear as ordinary locals (which is what
    # makes the finally-scrub effective).  The cache key
    # "eagle_debugger(secrets)" is shared across all calls in the
    # interpreter, so callers that need a fresh enumeration must clear
    # that entry themselves.
    #
    # Arguments:
    #   path        -- Path to the secret repository checkout directory;
    #                  enumerated recursively for "*.txt" files.
    #   withNull    -- Optional boolean.  When true, the literal "null"
    #                  is appended to the returned command list so the
    #                  command can be evaluated directly.  Defaults to
    #                  false (caller must supply the placeholder).
    #   filePattern -- Optional initial value for the file-name match
    #                  pattern.  When empty, the apply prompts the user
    #                  interactively via Interaction.InputBox.
    #   patterns    -- Optional list of additional custom regex patterns
    #                  forwarded into the search; the empty string means
    #                  use only the pre-configured patterns.
    #
    # Results:
    #   A list-form command suitable for later evaluation that, when
    #   run, prompts and copies a matching secret to the clipboard.
    # </help>

    set result [list apply [list [list state] \
        [string map [list %path% $path %filePattern% $filePattern \
        %patterns% $patterns] {
      try {
        set path {%path%}
        set filePattern {%filePattern%}
        set patterns {%patterns%}

        set ::HotKey.Enterprise_NoComplaintForm true; # EXEMPT
        set ::env(AllowAnyThread) 1; # EXEMPT

        package require HotKey.Enterprise

        set assembly [object load -import Microsoft.VisualBasic]

        if {[string length $filePattern] == 0} then {
          set filePattern [object invoke \
              Interaction InputBox "Enter secret file pattern:" \
              [hotkey title]]
        }

        if {[string length $filePattern] > 0} then {
          if {[info exists ::eagle_debugger(secrets)]} then {
            set fileNames $::eagle_debugger(secrets)
          } else {
            set fileNames [set ::eagle_debugger(secrets) \
                [findFilesRecursive [file join $path *.txt]]]
          }

          return [findAndCopySecret $fileNames $filePattern $patterns]
        }

        return false
      } finally {
        unset -nocomplain -zerostring -purge -- \
            path filePattern patterns assembly fileNames
      }
    }] [namespace current]]]

    if {$withNull} then {
      lappend result null
    }

    return $result
  }

  #
  # NOTE: This procedure searches the specified list of secret repository
  #       checkout files searching for a secret.  If a matching secret is
  #       found, it will be (temporarily) copied to the operating system
  #       clipboard.  Non-zero will be returned upon success.
  #
  proc findAndCopySecret { fileNames filePattern patterns } {
    # <help>
    # This procedure walks the supplied list of candidate secret files,
    # selects the ones whose tail file names match the caller-supplied
    # pattern, reads the contents of the first match, and asks
    # [copySecretFromData] to extract and copy the secret to the
    # clipboard.  It returns success as soon as any file successfully
    # yields a secret.
    #
    # SECURITY: This procedure reads on-disk secret files into the
    # interpreter via [readFile].  The plaintext is held in the local
    # "data" variable for the duration of the [copySecretFromData] call
    # and is then explicitly scrubbed -- along with all other locals
    # that touched secret-adjacent values -- by the finally clause using
    # the zero-string scrubbing form of unset.  If no file yields a
    # secret, the procedure returns false and the contents that were
    # loaded are still scrubbed.
    #
    # How it works: empty inputs raise errors up front -- a missing file
    # list is reported as "no secret files" and a missing pattern as
    # "no secret pattern".  The procedure then iterates over each
    # candidate path.  For each one, it computes the bare tail name and
    # decides whether the caller's pattern already contains
    # string-match wildcards (using the non-public
    # StringOps.HasStringMatchChar helper); if not, the pattern is
    # bracketed with leading and trailing asterisks so it matches as a
    # substring rather than an exact name.  A suffix of ".txt" is
    # appended and [string match -nocase] is used to test the bare tail
    # name.  On a match, the file is read in full and handed to
    # [copySecretFromData] along with the bare tail and any custom
    # patterns; if that call reports success, true is returned
    # immediately.  If no file matches or no match yields a secret,
    # false is returned.
    #
    # Tricky details: the candidate-file pattern is matched against the
    # tail name only, not the full path, and the match is case
    # insensitive; case sensitivity is intentionally relaxed because
    # filesystems on Windows are case insensitive.  The first
    # successful match wins -- the procedure does not continue scanning
    # to find "better" matches.
    #
    # Arguments:
    #   fileNames   -- Non-empty list of candidate file paths to scan.
    #   filePattern -- Non-empty file-name pattern used to filter
    #                  candidates; may already contain string-match
    #                  wildcards or may be a bare substring.
    #   patterns    -- Optional list of additional custom regex patterns
    #                  forwarded into [copySecretFromData].
    #
    # Results:
    #   True when a matching file yielded a secret and it was copied
    #   to the clipboard, false otherwise.  Raises an error when either
    #   "fileNames" or "filePattern" is empty.
    # </help>

    try {
      if {[llength $fileNames] == 0} then {
        error "no secret files"
      }

      if {[string length $filePattern] == 0} then {
        error "no secret pattern"
      }

      foreach fileName $fileNames {
        set fileNameOnly [file tail $fileName]

        if {[object invoke -flags +NonPublic \
            Eagle._Components.Private.StringOps \
            HasStringMatchChar $filePattern]} then {
          set localFilePattern $filePattern
        } else {
          set localFilePattern [appendArgs * $filePattern *]
        }

        if {[string match -nocase \
            [appendArgs $localFilePattern .txt] $fileNameOnly]} then {
          set data [readFile $fileName]

          if {[copySecretFromData $fileNameOnly $data $patterns]} then {
            return true
          }
        }
      }

      return false
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNames filePattern patterns fileName fileNameOnly \
          localFilePattern data
    }
  }

  #
  # NOTE: This procedure attempts to extract a secret from the specified
  #       data, which is assumed to be from a secret repository checkout
  #       file.  Non-zero will be returned upon success.
  #
  proc copySecretFromData { fileNameOnly data patterns } {
    # <help>
    # This procedure extracts a single secret value from the contents of
    # one secret repository checkout file and asks
    # [copySecretToClipboard] to put it on the operating system
    # clipboard.  Two extraction strategies are supported: when the
    # file body is a single line, the entire body is treated as the
    # secret; when it contains multiple lines, a list of regular
    # expression patterns is tested in priority order until one
    # matches.
    #
    # SECURITY: The full file contents are present in the "data"
    # parameter for the duration of this call and are explicitly
    # scrubbed by the finally clause along with the per-iteration
    # "passwords" capture and the pattern map.  The plaintext secret
    # itself is handed off to [copySecretToClipboard] for the actual
    # clipboard transfer; the password value is trimmed of surrounding
    # whitespace before being copied so accidental newlines are not
    # included.  When no pattern matches, false is returned and no
    # clipboard mutation occurs.
    #
    # How it works: if there is no newline anywhere in "data", the
    # entire body is treated as the secret and [copySecretToClipboard]
    # is invoked with empty placeholder fields for the custom-pattern
    # bookkeeping; the procedure then returns true immediately.
    # Otherwise, [setupSecretPatterns] is called to materialize an
    # ordered list of pattern identifiers into local "pattern" and
    # "custom" arrays, with the caller's extra "patterns" appended to
    # the pre-configured set.  The identifiers are iterated and for
    # each one the corresponding regex is run against the full data
    # with [regexp -all -inline -line -nocase -skip 1 --], where the
    # -skip 1 option discards the leading full-match group so that
    # capture groups become the result list.  The first identifier that
    # produces a non-empty capture wins; the LAST element of that
    # capture list, trimmed, is copied to the clipboard with the
    # identifier and the custom-pattern map passed along for logging.
    # When at least one match was found the procedure returns true; if
    # no pattern matches it returns false.
    #
    # Tricky details: only the last capture is preserved, on the
    # assumption that secret files typically place the most recent
    # value last; older entries in the same file are ignored even when
    # they match.  Custom regex patterns are evaluated alongside
    # pre-configured ones, distinguished only by which array the
    # identifier is recorded into; the eventual log line varies based
    # on whether the identifier maps to a custom or built-in pattern.
    #
    # Arguments:
    #   fileNameOnly -- Bare tail name of the source file, used in
    #                   downstream log messages so the operator can see
    #                   which file produced the clipboard secret.
    #   data         -- Full contents of the file as a single string.
    #   patterns     -- Optional list of additional custom regex
    #                   patterns appended to the pre-configured set
    #                   for this call.
    #
    # Results:
    #   True when a secret was extracted and copied to the clipboard,
    #   false otherwise.
    # </help>

    try {
      if {[string first \n $data] == -1} then {
        copySecretToClipboard $fileNameOnly "" "" $data

        return true
      } else {
        set found 0

        foreach id [setupSecretPatterns pattern custom $patterns] {
          set passwords [regexp -all -inline -line \
              -nocase -skip 1 -- $pattern($id) $data]

          if {[llength $passwords] > 0} then {
            copySecretToClipboard $fileNameOnly custom \
                $id [string trim [lindex $passwords end]]

            incr found; break
          }
        }

        if {$found > 0} then {
          return true
        }
      }

      return false
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNameOnly data found id pattern passwords
    }
  }

  #
  # NOTE: This procedure sets up the list of patterns to be matched against
  #       the content of secret repository checkout files that may contain
  #       a secret.  More patterns may be added in the future.  Generally,
  #       each pattern will be matched against the entire contents of the
  #       candidate secret repository checkout file.  All pre-configured
  #       patterns will be loaded from the "secrets-patterns.eagle" file,
  #       within the same directory as this script file.
  #
  proc setupSecretPatterns { patternVarName customVarName {patterns ""} } {
    # <help>
    # This procedure materializes the array of regular expression
    # patterns used by [copySecretFromData] to extract a secret from a
    # multi-line file body, and returns those patterns' identifiers in
    # the order they should be tried.  The pre-configured patterns are
    # loaded by sourcing a sibling file named "secrets-patterns.eagle"
    # under the package's settings directory, and any additional
    # caller-supplied patterns are appended to the result.
    #
    # SECURITY: The patterns themselves are not secret, but they are
    # the rules by which secrets are recognized; tampering with them
    # would broaden or narrow the set of values treated as secret.  The
    # package path used to locate the patterns file is therefore
    # captured at package load time into a namespace variable (or a
    # debugger array fallback) and must be available at call time --
    # if it cannot be found, the procedure refuses to continue with an
    # explicit error rather than silently sourcing a default.
    #
    # How it works: the procedure first locates the package path,
    # preferring the namespace variable "secretsPackagePath" but
    # falling back to "eagle_debugger(secretsPackagePath)" for
    # interpreters that disable namespaces; if neither is present, an
    # error is raised.  Caller-supplied upvar aliases are then
    # established for the "pattern" and "custom" arrays (skipped when
    # the corresponding name is the empty string).  The settings file
    # is sourced -- the side effect of which is to populate the
    # "pattern" array with the built-in regex patterns -- and the
    # length of the caller-supplied "patterns" list is taken.  When
    # there are extra patterns, the current size of "pattern" is
    # snapshotted into "oldLength" and each extra pattern is added at
    # an index one past the previous high-water mark; the same value
    # is mirrored into the "custom" array so the caller can later tell
    # which identifiers came from the caller.  Finally, the integer
    # keys of "pattern" are listed, sorted numerically, and reversed
    # so that the largest (and therefore most recently added) patterns
    # are tried first.
    #
    # Tricky details: the use of integer-typed array keys is load
    # bearing -- the lsort -integer call assumes all keys parse as
    # integers, which is enforced by the index arithmetic above and by
    # the conventions of the sourced settings file.  The custom-pattern
    # bookkeeping uses the SAME identifier as the pattern entry, so
    # callers must avoid colliding indices.
    #
    # Arguments:
    #   patternVarName -- Name of the variable in the caller's frame
    #                     that receives the populated "pattern" array;
    #                     empty string disables the upvar.
    #   customVarName  -- Name of the variable in the caller's frame
    #                     that receives the populated "custom" array;
    #                     empty string disables the upvar.
    #   patterns       -- Optional list of additional regex patterns
    #                     appended to the pre-configured set for this
    #                     call.
    #
    # Results:
    #   A list of integer identifiers (descending), one per pattern in
    #   the populated array, in the order they should be tried.
    #   Raises an error when the package path cannot be located.
    # </help>

    variable secretsPackagePath

    if {[info exists secretsPackagePath]} then {
      set path $secretsPackagePath
    } elseif {[info exists ::eagle_debugger(secretsPackagePath)]} then {
      set path $::eagle_debugger(secretsPackagePath)
    } else {
      error "missing secrets package path, cannot continue"
    }

    if {[string length $patternVarName] > 0} then {
      upvar 1 $patternVarName pattern
    }

    if {[string length $customVarName] > 0} then {
      upvar 1 $customVarName custom
    }

    source [file join $path settings secrets-patterns.eagle]

    set newLength [llength $patterns]

    if {$newLength > 0} then {
      set oldLength [array size pattern]

      for {set index 0} {$index < $newLength} {incr index} {
        set newIndex [expr {$index + $oldLength + 1}]

        set pattern($newIndex) [lindex $patterns $index]
        set custom($newIndex) $pattern($newIndex)
      }
    }

    return [lreverse [lsort -integer [array names pattern]]]
  }

  #
  # NOTE: This procedure arranges for the specified secret data to be copied
  #       to the operating system clipboard.  The operating system clipboard
  #       is assumed to be secure.
  #
  proc copySecretToClipboard { fileNameOnly varName id secret } {
    # <help>
    # This procedure puts a single secret value onto the operating
    # system clipboard via the HotKey enterprise plugin and writes a
    # human-readable log entry describing which file and which pattern
    # the secret came from.  It is the final stop on the secret
    # extraction pipeline; everything upstream of it works to identify
    # the correct value to put through this one call.
    #
    # SECURITY: The operating system clipboard is assumed to be
    # sufficiently secure for the brief lifetime of the secret -- the
    # design choice here is to lean on the clipboard as a short-lived
    # transfer channel rather than to invent a new bespoke one.  The
    # secret is handed to "hotkey secret -copy --" which performs the
    # actual transfer; the secret value, the source file name, and the
    # identifier are then explicitly scrubbed from the local frame
    # using the zero-string scrubbing form of unset in the finally
    # clause so that no copy of the plaintext lingers in this frame.
    # Callers are expected to schedule a companion call to
    # [removeSecretFromClipboard] to clear the clipboard after a
    # bounded window of time (see [promptForAndCopySecret]).
    #
    # How it works: when "varName" is non-empty, an upvar alias is
    # established so the procedure can consult the caller's "custom"
    # array when deciding how to describe the matched pattern in the
    # log.  The clipboard transfer is performed via [hotkey secret
    # -copy -- $secret].  If "id" parses as a strict integer, the log
    # message references a pattern -- using the custom pattern's
    # source text when the identifier is recorded in the custom array,
    # or the pattern's numeric identifier otherwise.  If "id" is not
    # an integer (for example when the entire file was copied as a
    # single-line secret), the log message simply notes that a text
    # line was copied.
    #
    # Tricky details: the procedure returns the empty string rather
    # than a success flag; callers should infer success from the
    # absence of a raised exception.  The finally clause does NOT
    # scrub "varName" or "data" because those are not present in this
    # frame as locals -- only the secret-adjacent values that ARE
    # local here are scrubbed.
    #
    # Arguments:
    #   fileNameOnly -- Bare tail name of the source file; used in the
    #                   log message but not transferred to the
    #                   clipboard.
    #   varName      -- Name of the caller's "custom" array used to
    #                   look up the source text of custom patterns;
    #                   empty string disables the upvar.
    #   id           -- Pattern identifier.  When an integer, it is
    #                   used to look up the custom pattern text and is
    #                   embedded in the log message; otherwise the log
    #                   message reports a plain text line.
    #   secret       -- The actual secret value to copy to the
    #                   clipboard.
    #
    # Results:
    #   An empty string on success; raises an error if the clipboard
    #   transfer fails.
    # </help>

    try {
      if {[string length $varName] > 0} then {
        upvar 1 $varName custom
      }

      hotkey secret -copy -- $secret

      if {[string is integer -strict $id]} then {
        if {[info exists custom($id)]} then {
          set text [appendArgs \
              "custom pattern \{" $custom($id) \}]
        } else {
          set text [appendArgs "pattern #" $id]
        }

        hotkey log [appendArgs \
            "Copied password from \"" $fileNameOnly \
            "\" to the clipboard using " $text .]
      } else {
        hotkey log [appendArgs \
            "Copied text line from \"" $fileNameOnly \
            "\" to the clipboard."]
      }

      return ""
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNameOnly id secret
    }
  }

  #
  # NOTE: This procedure is called to remove previously copied secret data
  #       from the operating system clipboard.  Generally, the secret data
  #       is only left on the operating system clipboard for about thirty
  #       seconds before being removed.
  #
  proc removeSecretFromClipboard {} {
    # <help>
    # This procedure scrubs any previously copied secret from the
    # operating system clipboard.  It is the deferred cleanup half of
    # the secret transfer mechanism -- [copySecretToClipboard] puts a
    # value onto the clipboard for short-term use, and this procedure
    # replaces it with a "null" value once the bounded window for use
    # has elapsed (typically after about thirty seconds, as scheduled
    # by [promptForAndCopySecret]).
    #
    # SECURITY: The clipboard is replaced with the value of
    # [debug null] rather than left holding the secret.  This is the
    # primary lifetime control for any secret materialized by the
    # package -- once this procedure has run, the previously copied
    # secret is no longer accessible to other applications via the
    # clipboard.  Callers that need to extend the lifetime should
    # adjust the scheduled delay before invocation; callers that need
    # to scrub early can simply call this procedure on demand.  A
    # short log line is emitted so the operator has a clear audit
    # trail of the clear event.
    #
    # How it works: the procedure invokes [hotkey secret -copy --
    # [debug null]] so that whatever the clipboard currently contains
    # is overwritten with the engine's null value.  A single log line
    # ("Cleared clipboard.") is then sent through [hotkey log], and an
    # empty string is returned.
    #
    # Tricky details: the procedure does not check or report what was
    # on the clipboard before the clear; it unconditionally overwrites
    # whatever is there.  If the user (or another application) put a
    # non-secret value on the clipboard after the secret, that value
    # will also be lost.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   An empty string; raises an error if either the clipboard
    #   transfer or the log call fails.
    # </help>

    hotkey secret -copy -- [debug null]
    hotkey log "Cleared clipboard."

    return ""
  }

  #
  # NOTE: Save the full path to this running script for later; however, as
  #       a "safety" precaution, only use a namespace variable here if we
  #       can establish that namespace support is enabled, i.e. avoid use
  #       of a global variable; otherwise, use the reserved Eagle debugger
  #       array variable.
  #
  if {[namespace enable]} then {
    variable secretsPackagePath [file dirname [info script]]
  } else {
    set ::eagle_debugger(secretsPackagePath) [file dirname [info script]]
  }

  #
  # NOTE: Provide the "secrets" package to the interpreter.
  #
  package provide Eagle.Secrets \
    [expr {[isEagle] ? [info engine PatchLevel] : "1.0"}]
}
