#
# NOTE: Use our own namespace here because even though we do not directly
#       support namespaces ourselves, we do not want to pollute the global
#       namespace if this script actually ends up being evaluated in Tcl.
#
namespace eval ::Secrets {
  #
  # NOTE: This procedure will prompt the interactive user for a file name
  #       pattern to match against file names within the secret repository
  #       checkout directory.  Non-zero will be returned upon success.
  #
  proc promptForAndCopySecret { {envVarName KEYS_DIR} {milliseconds 30000} } {
    try {
      if {![info exists ::env($envVarName)]} then {
        error [appendArgs \
            "missing environment variable " $envVarName]
      }

      set path [file normalize $::env($envVarName)]

      set command [getSecretSearchCommand $path]; # get script.
      lappend command null; # [apply] needs one argument.
      set result [eval $command]; # block on this thread.

      if {$milliseconds >= 0} then {
        after $milliseconds \
            [namespace code removeSecretFromClipboard]

        after $milliseconds [list set ::secretForever 1]
        after $milliseconds [list set ::setecAstronomy 1]

        vwait ::secretForever
      }

      return $result
    } finally {
      unset -nocomplain -zerostring -purge -- envVarName \
          milliseconds command result
    }
  }

  #
  # NOTE: This procedure returns a (script) command that will prompt the
  #       interactive user for a file name pattern to match against file
  #       names within the secret repository checkout directory.  Non-zero
  #       will be returned upon success.
  #
  proc getSecretSearchCommand {
          path {withNull false} {filePattern ""} {patterns ""} } {
    set result [list apply [list [list state] \
        [string map [list %path% $path %filePattern% $filePattern \
        %patterns% $patterns] {
      try {
        set path {%path%}
        set filePattern {%filePattern%}
        set patterns {%patterns%}

        set ::HotKey.Enterprise_NoComplaintForm true; # EXEMPT
        set ::env(AllowAnyThread) 1; # EXEMPT

        package require HotKey.Enterprise

        set assembly [object load -import Microsoft.VisualBasic]

        if {[string length $filePattern] == 0} then {
          set filePattern [object invoke \
              Interaction InputBox "Enter secret file pattern:" \
              [hotkey title]]
        }

        if {[string length $filePattern] > 0} then {
          if {[info exists ::eagle_debugger(secrets)]} then {
            set fileNames $::eagle_debugger(secrets)
          } else {
            set fileNames [set ::eagle_debugger(secrets) \
                [findFilesRecursive [file join $path *.txt]]]
          }

          return [findAndCopySecret $fileNames $filePattern $patterns]
        }

        return false
      } finally {
        unset -nocomplain -zerostring -purge -- \
            path filePattern patterns assembly fileNames
      }
    }] [namespace current]]]

    if {$withNull} then {
      lappend result null
    }

    return $result
  }

  #
  # NOTE: This procedure searches the specified list of secret repository
  #       checkout files searching for a secret.  If a matching secret is
  #       found, it will be (temporarily) copied to the operating system
  #       clipboard.  Non-zero will be returned upon success.
  #
  proc findAndCopySecret { fileNames filePattern patterns } {
    try {
      if {[llength $fileNames] == 0} then {
        error "no secret files"
      }

      if {[string length $filePattern] == 0} then {
        error "no secret pattern"
      }

      foreach fileName $fileNames {
        set fileNameOnly [file tail $fileName]

        if {[object invoke -flags +NonPublic \
            Eagle._Components.Private.StringOps \
            HasStringMatchChar $filePattern]} then {
          set localFilePattern $filePattern
        } else {
          set localFilePattern [appendArgs * $filePattern *]
        }

        if {[string match -nocase \
            [appendArgs $localFilePattern .txt] $fileNameOnly]} then {
          set data [readFile $fileName]

          if {[copySecretFromData $fileNameOnly $data $patterns]} then {
            return true
          }
        }
      }

      return false
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNames filePattern patterns fileName fileNameOnly \
          localFilePattern data
    }
  }

  #
  # NOTE: This procedure attempts to extract a secret from the specified
  #       data, which is assumed to be from a secret repository checkout
  #       file.  Non-zero will be returned upon success.
  #
  proc copySecretFromData { fileNameOnly data patterns } {
    try {
      if {[string first \n $data] == -1} then {
        copySecretToClipboard $fileNameOnly "" "" $data

        return true
      } else {
        set found 0

        foreach id [setupSecretPatterns pattern custom $patterns] {
          set passwords [regexp -all -inline -line \
              -nocase -skip 1 -- $pattern($id) $data]

          if {[llength $passwords] > 0} then {
            copySecretToClipboard $fileNameOnly custom \
                $id [string trim [lindex $passwords end]]

            incr found; break
          }
        }

        if {$found > 0} then {
          return true
        }
      }

      return false
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNameOnly data found id pattern passwords
    }
  }

  #
  # NOTE: This procedure sets up the list of patterns to be matched against
  #       the content of secret repository checkout files that may contain
  #       a secret.  More patterns may be added in the future.  Generally,
  #       each pattern will be matched against the entire contents of the
  #       candidate secret repository checkout file.  All pre-configured
  #       patterns will be loaded from the "secrets-patterns.eagle" file,
  #       within the same directory as this script file.
  #
  proc setupSecretPatterns { patternVarName customVarName {patterns ""} } {
    variable secretsPackagePath

    if {[info exists secretsPackagePath]} then {
      set path $secretsPackagePath
    } elseif {[info exists ::eagle_debugger(secretsPackagePath)]} then {
      set path $::eagle_debugger(secretsPackagePath)
    } else {
      error "missing secrets package path, cannot continue"
    }

    if {[string length $patternVarName] > 0} then {
      upvar 1 $patternVarName pattern
    }

    if {[string length $customVarName] > 0} then {
      upvar 1 $customVarName custom
    }

    source [file join $path settings secrets-patterns.eagle]

    set newLength [llength $patterns]

    if {$newLength > 0} then {
      set oldLength [array size pattern]

      for {set index 0} {$index < $newLength} {incr index} {
        set newIndex [expr {$index + $oldLength + 1}]

        set pattern($newIndex) [lindex $patterns $index]
        set custom($newIndex) $pattern($newIndex)
      }
    }

    return [lreverse [lsort -integer [array names pattern]]]
  }

  #
  # NOTE: This procedure arranges for the specified secret data to be copied
  #       to the operating system clipboard.  The operating system clipboard
  #       is assumed to be secure.
  #
  proc copySecretToClipboard { fileNameOnly varName id secret } {
    try {
      if {[string length $varName] > 0} then {
        upvar 1 $varName custom
      }

      hotkey secret -copy -- $secret

      if {[string is integer -strict $id]} then {
        if {[info exists custom($id)]} then {
          set text [appendArgs \
              "custom pattern \{" $custom($id) \}]
        } else {
          set text [appendArgs "pattern #" $id]
        }

        hotkey log [appendArgs \
            "Copied password from \"" $fileNameOnly \
            "\" to the clipboard using " $text .]
      } else {
        hotkey log [appendArgs \
            "Copied text line from \"" $fileNameOnly \
            "\" to the clipboard."]
      }

      return ""
    } finally {
      unset -nocomplain -zerostring -purge -- \
          fileNameOnly id secret
    }
  }

  #
  # NOTE: This procedure is called to remove previously copied secret data
  #       from the operating system clipboard.  Generally, the secret data
  #       is only left on the operating system clipboard for about thirty
  #       seconds before being removed.
  #
  proc removeSecretFromClipboard {} {
    hotkey secret -copy -- [debug null]
    hotkey log "Cleared clipboard."

    return ""
  }

  #
  # NOTE: Save the full path to this running script for later; however, as
  #       a "safety" precaution, only use a namespace variable here if we
  #       can establish that namespace support is enabled, i.e. avoid use
  #       of a global variable; otherwise, use the reserved Eagle debugger
  #       array variable.
  #
  if {[namespace enable]} then {
    variable secretsPackagePath [file dirname [info script]]
  } else {
    set ::eagle_debugger(secretsPackagePath) [file dirname [info script]]
  }

  #
  # NOTE: Provide the "secrets" package to the interpreter.
  #
  package provide Eagle.Secrets \
    [expr {[isEagle] ? [info engine PatchLevel] : "1.0"}]
}
