puts stdout ""
puts stdout [string repeat = 80]
puts stdout "enable personalLicenses"
puts stdout [string repeat = 80]
puts stdout ""

foreach x [::Licensing::personalLicenses "" [file normalize $::env(XDG_STARTUP_HOME)] 1 0 1] {puts stdout [appendArgs \t [lindex $x 0] " ==>\n\t\t" [file tail [lindex $x end]] \n]}
foreach x [::Licensing::personalLicenses main [file normalize $::env(XDG_STARTUP_HOME)] 1 0 1] {puts stdout [appendArgs \t [lindex $x 0] " ==>\n\t\t" [file tail [lindex $x end]] \n]}
foreach x [::Licensing::personalLicenses Zeus.Enterprise [file normalize $::env(XDG_STARTUP_HOME)] 1 0 1] {puts stdout [appendArgs \t [lindex $x 0] " ==>\n\t\t" [file tail [lindex $x end]] \n]}

