###############################################################################
# NOTE: Order of these patterns is reversed when checking lines with [regexp].
###############################################################################

set pattern(1) {^pass(?:word)?:\s+(.*)$}
set pattern(2) {\s+pass(?:word)?:\s+(.*)$}

set pattern(3) [appendArgs \
    {^(?:new )?pass(?:word)?} {(?: for)?(?: \d{4})?} \
    {(?: \([^\)]+\))?:\s+([^\s]+)\s+}]

set pattern(4) {\s+fossil pass:\s+(.*)$}
