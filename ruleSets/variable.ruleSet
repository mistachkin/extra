###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that deal with script variable manipulation.  Most of these are "safe",
#       i.e. all of them except [getf], [setf], and [unsetf].
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns array
}

rule {
  type Include kind Command mode {Include Exact} patterns getf
}

rule {
  type Include kind Command mode {Include Exact} patterns global
}

rule {
  type Include kind Command mode {Include Exact} patterns incr
}

rule {
  type Include kind Command mode {Include Exact} patterns scope
}

rule {
  type Include kind Command mode {Include Exact} patterns set
}

rule {
  type Include kind Command mode {Include Exact} patterns setf
}

rule {
  type Include kind Command mode {Include Exact} patterns unset
}

rule {
  type Include kind Command mode {Include Exact} patterns unsetf
}

rule {
  type Include kind Command mode {Include Exact} patterns upvar
}

rule {
  type Include kind Command mode {Include Exact} patterns vwait
}

rule {
  type Include kind Command mode {Include Exact} patterns variable
}

rule {
  type Include kind Command mode {Include Exact} patterns namespace
}
