###############################################################################
# NOTE: This ruleset is designed to allow all core library commands that were
#       added in Tcl 8.6, including those that are "unsafe".
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns coroutine
}

rule {
  type Include kind Command mode {Include Exact} patterns yield
}

rule {
  type Include kind Command mode {Include Exact} patterns yieldto
}

rule {
  type Include kind Command mode {Include Exact} patterns zlib
}
