###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that deal purely with introspection.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns clock
}

rule {
  type Include kind Command mode {Include Exact} patterns info
}

rule {
  type Include kind Command mode {Include Exact} patterns pid
}

rule {
  type Include kind Command mode {Include Exact} patterns version
}
