###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that deal with string script variable and/or value manipulation.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns append
}

rule {
  type Include kind Command mode {Include Exact} patterns base64
}

rule {
  type Include kind Command mode {Include Exact} patterns concat
}

rule {
  type Include kind Command mode {Include Exact} patterns encoding
}

rule {
  type Include kind Command mode {Include Exact} patterns format
}

rule {
  type Include kind Command mode {Include Exact} patterns hash
}

rule {
  type Include kind Command mode {Include Exact} patterns join
}

rule {
  type Include kind Command mode {Include Exact} patterns regexp
}

rule {
  type Include kind Command mode {Include Exact} patterns regsub
}

rule {
  type Include kind Command mode {Include Exact} patterns split
}

rule {
  type Include kind Command mode {Include Exact} patterns string
}
