###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that deal with manipulating script environment, managed environment, or
#       the native environment.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns debug
}

rule {
  type Include kind Command mode {Include Exact} patterns guid
}

rule {
  type Include kind Command mode {Include Exact} patterns host
}

rule {
  type Include kind Command mode {Include Exact} patterns interp
}

rule {
  type Include kind Command mode {Include Exact} patterns library
}

rule {
  type Include kind Command mode {Include Exact} patterns object
}

rule {
  type Include kind Command mode {Include Exact} patterns package
}

rule {
  type Include kind Command mode {Include Exact} patterns sql
}

rule {
  type Include kind Command mode {Include Exact} patterns tcl
}

rule {
  type Include kind Command mode {Include Exact} patterns time
}

rule {
  type Include kind Command mode {Include Exact} patterns xml
}
