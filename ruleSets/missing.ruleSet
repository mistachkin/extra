###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.4 commands that are
#       missing from the Eagle core library.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns binary
}

rule {
  type Include kind Command mode {Include Exact} patterns case
}

rule {
  type Include kind Command mode {Include Exact} patterns dde
}

rule {
  type Include kind Command mode {Include Exact} patterns fileevent
}

rule {
  type Include kind Command mode {Include Exact} patterns history
}

rule {
  type Include kind Command mode {Include Exact} patterns memory
}

rule {
  type Include kind Command mode {Include Exact} patterns pkg::create
}

rule {
  type Include kind Command mode {Include Exact} patterns pkg_mkIndex
}

rule {
  type Include kind Command mode {Include Exact} patterns registry
}

rule {
  type Include kind Command mode {Include Exact} patterns scan
}

rule {
  type Include kind Command mode {Include Exact} patterns tcl_findLibrary
}

rule {
  type Include kind Command mode {Include Exact} patterns trace
}
