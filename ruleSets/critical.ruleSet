###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that are considered to be "critically" unsafe, i.e. if any of these are
#       available, they can be used to bypass other safety / security features.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns debug
}

rule {
  type Include kind Command mode {Include Exact} patterns file
}

rule {
  type Include kind Command mode {Include Exact} patterns host
}

rule {
  type Include kind Command mode {Include Exact} patterns library
}

rule {
  type Include kind Command mode {Include Exact} patterns load
}

rule {
  type Include kind Command mode {Include Exact} patterns object
}

rule {
  type Include kind Command mode {Include Exact} patterns tcl
}

rule {
  type Include kind Command mode {Include Exact} patterns unload
}
