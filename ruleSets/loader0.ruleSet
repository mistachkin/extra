###############################################################################
# NOTE: This ruleset is designed to allow for the special commands provided by
#       the Eagle plugin loader subsystem.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns maybeCreatePackageIfNeededCommand
}

rule {
  type Include kind Command mode {Include Exact} patterns sourceWithInfo
}
