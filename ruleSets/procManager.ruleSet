###############################################################################
# NOTE: This ruleset is designed to allow for the Tcl 8.x and/or Eagle commands
#       that deal with (re-)defining procedures.
###############################################################################

rule {
  type Include kind Command mode {Include Exact} patterns namespace
}

rule {
  type Include kind Command mode {Include Exact} patterns nproc
}

rule {
  type Include kind Command mode {Include Exact} patterns proc
}

rule {
  type Include kind Command mode {Include Exact} patterns rename
}
