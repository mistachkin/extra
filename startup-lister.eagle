apply [list [list script] {
  set result [list]

  source [file join \
      [file dirname $script] Settings startup-settings-files.eagle]

  if {[info exists phases]} then {
    foreach phase $phases {
      if {[info exists directories($phase)]} then {
        set directory $directories($phase)
      } else {
        set directory $path
      }

      if {[info exists fileNamesOnly($phase)]} then {
        foreach fileNameOnly $fileNamesOnly($phase) {
          lappend result [file join $directory $fileNameOnly]
        }
      }
    }
  }

  return $result
}] [info script]
