###############################################################################

apply [list [list script] {
  set path [file normalize [file dirname [file dirname $script]]]

  #############################################################################

  upvar 1 phases phases
  upvar 1 fileNamesOnly fileNamesOnly
  upvar 1 directories directories

  #############################################################################

  set directories(public) [file join $path LoadOnStartup Public]
  set directories(watchCat) [file join $path WatchCat]
  set directories(private) [file join $path LoadOnStartup Private]
  set directories(settings) [file join $path Settings]

  #############################################################################

  set fileNamesOnly(public) {
    backcompat.eagle
    chat.eagle
    helpers.eagle
    history.eagle
    intExtCmds.eagle
    secrets.eagle
    sms.eagle
  }

  set fileNamesOnly(watchCat) {
    watchCat.eagle
  }

  set fileNamesOnly(private) {
    auth.eagle
    intExtCmds_private.eagle
  }

  set fileNamesOnly(settings) {
    startup-settings.eagle
  }

  #############################################################################

  set phases {
    public
    watchCat
    private
    settings
  }
}] [info script]
